+    app.action_bar = native.CTkFrame(app, fg_color=color("surface"), corner_radius=14)
+    app.action_bar.grid(row=1, column=1, sticky="we", padx=20, pady=(0, 20))
+    app.action_bar.grid_columnconfigure(0, weight=1)
