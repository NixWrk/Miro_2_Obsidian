{
  "description": "Short labels above images keep a vertical clearance instead of overlapping image previews.",
  "converter": {
    "scale": 1.0,
    "min_font_px": 8,
    "theme": "dark"
  },
  "assertions": {
    "node_count": 4,
    "edge_count": 0,
    "nodes": [
      {
        "id": "label-rice",
        "type": "text",
        "min_width": 120,
        "text_contains": "RICE"
      },
      {
        "id": "label-kano",
        "type": "text",
        "min_width": 108,
        "text_contains": "Кано"
      },
      {
        "id": "image-rice",
        "type": "file",
        "file_contains": "rice_image.png"
      },
      {
        "id": "image-kano",
        "type": "file",
        "file_contains": "kano_image.png"
      }
    ],
    "non_overlapping_pairs": [
      [
        "label-rice",
        "image-rice"
      ],
      [
        "label-kano",
        "image-kano"
      ]
    ]
  }
}
